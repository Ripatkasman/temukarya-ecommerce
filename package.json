{
  "name": "temukarya",
  "version": "0.1.0",
  "private": true,
  "description": "TemuKarya - Tempat Karya Lokal Bertemu Kepercayaan. Marketplace multi-seller (Next.js + PostgreSQL).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:reset": "node --env-file=.env.local scripts/db-reset.mjs",
    "test:api": "node --env-file=.env.local scripts/db-reset.mjs --yes && node --env-file=.env.local tests/api/api.mjs",
    "test:hardening": "node --env-file=.env.local scripts/db-reset.mjs --yes && node --env-file=.env.local tests/api/hardening.mjs",
    "test:e2e:auth": "node --env-file=.env.local scripts/db-reset.mjs --yes && node --env-file=.env.local tests/e2e/public-auth.mjs",
    "test:e2e:dashboards": "node --env-file=.env.local scripts/db-reset.mjs --yes && node --env-file=.env.local tests/e2e/dashboards.mjs",
    "test:e2e:features": "node --env-file=.env.local scripts/db-reset.mjs --yes && node --env-file=.env.local tests/e2e/optional-features.mjs",
    "test:e2e:journey": "node --env-file=.env.local scripts/db-reset.mjs --yes && node --env-file=.env.local tests/e2e/journey.mjs",
    "test:e2e:audit": "node --env-file=.env.local scripts/db-reset.mjs --yes && node --env-file=.env.local tests/e2e/audit.mjs",
    "test:e2e:keyboard": "node --env-file=.env.local scripts/db-reset.mjs --yes && node --env-file=.env.local tests/e2e/keyboard-links.mjs",
    "test:e2e:images": "node --env-file=.env.local scripts/db-reset.mjs --yes && node --env-file=.env.local tests/e2e/images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5"
  }
}
